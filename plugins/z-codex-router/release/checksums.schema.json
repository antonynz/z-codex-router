{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Z Codex Router Release 校验和",
  "type": "object",
  "required": ["schemaVersion", "version", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-].+)?$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "platform", "arch", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^plugins/z-codex-router/bin/routerctl-(darwin|linux|windows)-(amd64|arm64)(\\.exe)?$"},
          "platform": {"enum": ["darwin", "linux", "windows"]},
          "arch": {"enum": ["amd64", "arm64"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "oneOf": [
          {
            "properties": {
              "platform": {"const": "darwin"},
              "arch": {"const": "amd64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-darwin-amd64"}
            }
          },
          {
            "properties": {
              "platform": {"const": "darwin"},
              "arch": {"const": "arm64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-darwin-arm64"}
            }
          },
          {
            "properties": {
              "platform": {"const": "linux"},
              "arch": {"const": "amd64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-linux-amd64"}
            }
          },
          {
            "properties": {
              "platform": {"const": "linux"},
              "arch": {"const": "arm64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-linux-arm64"}
            }
          },
          {
            "properties": {
              "platform": {"const": "windows"},
              "arch": {"const": "amd64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-windows-amd64.exe"}
            }
          },
          {
            "properties": {
              "platform": {"const": "windows"},
              "arch": {"const": "arm64"},
              "path": {"const": "plugins/z-codex-router/bin/routerctl-windows-arm64.exe"}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
