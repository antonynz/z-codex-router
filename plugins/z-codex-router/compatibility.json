{
  "schemaVersion": 1,
  "runtime": {
    "codexHomeRequired": true,
    "platforms": ["darwin", "linux", "windows"],
    "architectures": ["amd64", "arm64"],
    "requiredProfiles": [
      "portable/default.toml",
      "stable/current-gpt-5.6-reference.toml",
